{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Aethey/flutter_agents_md_helper/knowledge/schema/technology.schema.json",
  "title": "Technology",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "kind",
    "docsUrl",
    "verifiedAt",
    "sources",
    "facts",
    "copy"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "requirement",
        "package",
        "pattern"
      ]
    },
    "packageName": {
      "type": "string"
    },
    "impliedPackages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "docsUrl": {
      "type": "string",
      "format": "uri"
    },
    "verifiedAt": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "zh",
        "ja"
      ],
      "properties": {
        "en": {
          "$ref": "#/$defs/copy"
        },
        "zh": {
          "$ref": "#/$defs/copy"
        },
        "ja": {
          "$ref": "#/$defs/copy"
        }
      }
    }
  },
  "$defs": {
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "name",
        "summary",
        "description",
        "advantages",
        "tradeOffs",
        "recommendedWhen",
        "avoidWhen",
        "worksWellWith"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "advantages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tradeOffs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommendedWhen": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "avoidWhen": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "worksWellWith": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
