{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Flutter Knowledge Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updatedAt", "categories"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "updatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "categories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "items"],
        "properties": {
          "description": { "type": "string" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "path", "verifiedAt", "context7Required"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 },
                "verifiedAt": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "context7Required": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
