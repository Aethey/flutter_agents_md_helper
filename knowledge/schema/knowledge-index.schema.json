{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Aethey/flutter_agents_md_helper/knowledge/schema/knowledge-index.schema.json",
  "title": "KnowledgeIndex",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updatedAt", "flow", "categories"],
  "properties": {
    "version": { "type": "string" },
    "updatedAt": { "type": "string" },
    "flow": { "type": "string" },
    "categories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "entries"],
        "properties": {
          "path": { "type": "string" },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "file"],
              "properties": {
                "id": { "type": "string" },
                "file": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
