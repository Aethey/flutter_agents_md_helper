      "label": "Manual JSON",
      "name": "Manual",
      "summary": "Implement fromJson and toJson yourself.",
      "description": "Visible conversions, no generator. Nested models and added fields are easy to forget.",
      "advantages": [
        "Conversions are visible",
        "No generator",
        "Exceptions sit next to the mapping"
      ],
      "tradeOffs": [
        "New fields are easy to miss",
        "Nesting gets verbose"
      ],
      "recommendedWhen": [
        "Responses are flat",
        "Custom conversions dominate"
      ],
      "avoidWhen": [
        "Many models"
      ],
      "worksWellWith": [
        "Plain Dart",
        "http",
        "Manual API"
      ]
    },
