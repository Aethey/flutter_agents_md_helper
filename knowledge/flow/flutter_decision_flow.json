{
  "id":"flutter_default",
  "name":"Flutter architecture decision flow",
  "version":1,
  "updatedAt":"2026-09-16",
  "principles":["Ask about project requirements before presenting package choices.","Show only options relevant to prior answers.","Treat recommendations as requirement matches, not universal rankings.","Generate agent rules from committed decisions."],
  "stages":[
    {"id":"target","title":"Project Target","required":true,"questions":[{"id":"targets","prompt":"Which platforms will this project target?","type":"multi_select","options":["mobile","web","desktop"],"affects":["routing","persistence","native_bridge","monitoring"]}]},
    {"id":"scale","title":"Project Scale","required":true,"questions":[{"id":"scale","prompt":"How large and long-lived do you expect this project to be?","type":"single_select","options":["small","medium","large"],"affects":["project_structure","architecture","state_management","testing","tooling"]}]},
    {"id":"project_structure","title":"Project Structure","required":true,"questions":[{"id":"package_structure","prompt":"Will the repository contain multiple reusable or independently owned packages?","type":"single_select","options":[{"id":"single_package","technologyRefs":[]},{"id":"multi_package","technologyRefs":["dart_pub_workspaces","melos"]}]}]},
    {"id":"architecture","title":"Architecture","required":true,"questions":[{"id":"architecture_style","prompt":"How much separation of concerns does the project need?","type":"single_select","options":["simple_layered","feature_first","feature_first_with_domain_layer"],"guidanceSource":"https://docs.flutter.dev/app-architecture/guide"}]},
    {"id":"state_management","title":"State Management","required":true,"questions":[{"id":"state_profile","prompt":"What kind of state dominates the application?","type":"multi_select","options":["widget_local_ephemeral","shared_application_state","async_api_heavy","explicit_event_state_flow","dependency_injection_needed"]},{"id":"state_solution","prompt":"Choose the state-management approach that matches those requirements.","type":"single_select","technologyRefs":["set_state","provider","flutter_riverpod","flutter_bloc"]},{"id":"riverpod_codegen","prompt":"Use Riverpod code generation?","type":"single_select","showWhen":{"state_solution":"flutter_riverpod"},"technologyRefs":["riverpod_generator"]}]},
    {"id":"routing","title":"Navigation","required":true,"questions":[{"id":"routing_requirements","prompt":"Which navigation capabilities are required?","type":"multi_select","options":["simple_navigation","deep_links","web_urls","auth_redirects","nested_navigation","multiple_navigation_stacks","typed_routes"]},{"id":"routing_solution","prompt":"Choose a routing approach.","type":"single_select","technologyRefs":["navigator","go_router","auto_route"]},{"id":"typed_routing","prompt":"Use generated typed routes?","type":"single_select","showWhen":{"routing_requirements":"typed_routes"},"technologyRefs":["go_router_builder","auto_route_generator"]}]},
    {"id":"networking","title":"Backend and API","required":true,"questions":[{"id":"backend_type","prompt":"How does the app communicate with backend services?","type":"single_select","options":["none","rest","graphql","websocket_realtime"]},{"id":"rest_client","prompt":"Choose the HTTP client approach.","type":"single_select","showWhen":{"backend_type":"rest"},"technologyRefs":["http","dio"]},{"id":"rest_codegen","prompt":"Should REST endpoints be generated from declarations or contracts?","type":"single_select","showWhen":{"rest_client":"dio"},"technologyRefs":["retrofit","retrofit_generator"]}]},
    {"id":"models","title":"Models and Serialization","required":true,"questions":[{"id":"model_requirements","prompt":"What model features are important?","type":"multi_select","options":["plain_models","json_serialization","immutable_models","sealed_union_state"]},{"id":"model_tools","prompt":"Choose model/code-generation tools when needed.","type":"multi_select","technologyRefs":["freezed","json_serializable"]}]},
    {"id":"persistence","title":"Local Persistence","required":false,"questions":[{"id":"persistence_need","prompt":"What needs to be stored locally?","type":"single_select","options":["none","small_preferences","sensitive_values","relational_structured_data"]},{"id":"persistence_solution","prompt":"Choose the storage approach.","type":"single_select","technologyRefs":["shared_preferences","flutter_secure_storage","drift"]}]},
    {"id":"native_bridge","title":"Native Integration","required":false,"questions":[{"id":"native_complexity","prompt":"How complex is Flutter-to-native communication?","type":"single_select","options":["none","small_custom_bridge","large_typed_interface"]},{"id":"native_solution","prompt":"Choose the native communication approach.","type":"single_select","technologyRefs":["platform_channels","pigeon"]}]},
    {"id":"testing","title":"Testing Strategy","required":true,"questions":[{"id":"test_scope","prompt":"Which levels of automated testing should be part of the project rules?","type":"multi_select","options":["unit","widget","integration"],"technologyRefs":["flutter_test","integration_test"]}]},
    {"id":"quality","title":"Quality and Static Analysis","required":true,"questions":[{"id":"quality_profile","prompt":"How strict should static analysis be?","type":"single_select","options":["basic","strict","team_production"],"technologyRefs":["flutter_lints","riverpod_lint"]}]},
    {"id":"monitoring","title":"Monitoring and Analytics","required":false,"questions":[{"id":"monitoring_needs","prompt":"Which production signals are needed?","type":"multi_select","options":["crash_reporting","error_monitoring","product_analytics"],"technologyRefs":["firebase_crashlytics","sentry_flutter","firebase_analytics"]}]},
    {"id":"generated_tooling","title":"Code Generation","required":true,"derived":true,"questions":[{"id":"generator_summary","prompt":"Review the generators implied by previous choices.","type":"derived_review","technologyRefs":["build_runner","go_router_builder","auto_route_generator","riverpod_generator","freezed","json_serializable","retrofit_generator"]}]},
    {"id":"agent_rules","title":"Agent Rules","required":true,"derived":true,"questions":[{"id":"agent_rule_review","prompt":"Review rules generated from the committed architecture decisions.","type":"derived_review","options":["do_not_edit_generated_files","use_typed_routes_when_selected","do_not_add_second_state_management_library_without_reason","keep_business_logic_outside_widgets","prefer_typed_models_over_dynamic","run_flutter_analyze","run_affected_tests"]}]},
    {"id":"review","title":"Architecture Review","required":true,"derived":true,"questions":[{"id":"final_review","prompt":"Review all committed decisions before generating FLUTTER_ARCHITECTURE.md.","type":"final_review"}]}
  ]
}